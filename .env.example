# Firebase configuration — copy to .env and fill in your own project values.
# NEVER commit .env. See DEPLOYMENT.md for setup steps.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
# Optional: set to "true" to force demo mode even when keys are present.
VITE_DEMO_MODE=
# Image uploads use ImgBB through the server-side /api/upload proxy (Vercel).
# Put the key ONLY in Vercel env vars (and functions/.env for Cloud Functions).
# NEVER commit the real key or put it in frontend code — the repo is public.
IMGBB_API_KEY=
