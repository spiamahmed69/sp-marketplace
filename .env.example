# Firebase configuration — copy to .env and fill in your own project values.
# NEVER commit .env. See DEPLOYMENT.md for setup steps.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
# Optional: set to "true" to force demo mode even when keys are present.
VITE_DEMO_MODE=
